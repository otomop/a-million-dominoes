{
  "name": "a-million-dominoes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Draw a digit. A million falling dominoes work out which number you wrote.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "shots": "node scripts/shots.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0"
  }
}
